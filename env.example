## Qvantify local environment (DO NOT commit your real env file)
#
# Copy this file to `env.local` and fill values.
# The app loads env vars via python-dotenv.

# --- Database ---
# Prefer DATABASE_URL, especially when using Supabase pooler/session mode.
DATABASE_URL=

# Alternatively, configure the discrete parts:
# DB_HOST=
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_PORT=5432

# Supabase requires SSL
DB_SSLMODE=require

# --- OpenAI / LLM ---
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
OPENAI_PANDA_KEY=

# --- Voice input (optional) ---
# Audio transcription model (defaults to whisper-1).
VOICE_TRANSCRIPTION_MODEL=whisper-1
# Max audio upload size in bytes (defaults to 15728640 = 15MB).
VOICE_MAX_BYTES=15728640

# Optional app tuning
DEFAULT_PROMPT=
PANDA_PROJECT_ID=

# --- Results Portal (Admin + Share links) ---
# Enable local-only admin endpoints + UI (served under /results/projects).
# When unset/empty, admin endpoints return 404 (disabled).
ADMIN_LOCAL_KEY=

# Required for share-link login sessions (signed httpOnly cookie).
SECRET_KEY=

# Required to encrypt/decrypt share link tokens + passwords (Fernet key).
SHARE_LINK_ENC_KEY=

# Cookie config (set SESSION_COOKIE_SECURE=true in production HTTPS environments)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Brute-force protection for share-link password login
SHARE_LOGIN_RATE_WINDOW_MIN=15
SHARE_LOGIN_RATE_MAX_FAILURES=8

# --- Internal diagnostics (optional) ---
# Protects internal-only endpoints:
#   GET /api/debug/?key=...
#   GET /api/heartbeat/?key=...
# When unset/empty, these endpoints are disabled (404).
INTERNAL_API_KEY=

# --- Observability (optional) ---
# Prefer env over hardcoding secrets in config files.
NEW_RELIC_LICENSE_KEY=

# --- Supabase (optional) ---
# Used by optional scripts / helpers (not required for the Flask app to run).
SUPABASE_PROJECT_REF=
SUPABASE_API_KEY=

# Used by the Node/Vercel side (if you deploy /api/* functions separately).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# --- Vercel proxy (static frontend) ---
# Used by the Vercel API proxy to route /api/* to Railway.
QVANTIFY_RAILWAY_URL=

# --- E2E (optional) ---
QVANTIFY_E2E_BASE_URL=
QVANTIFY_PROJECT_ID=
QVANTIFY_EXTERNAL_ID=
