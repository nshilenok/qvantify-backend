{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/[...path].cjs", "use": "@vercel/node" }
  ],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "/api/[...path].cjs?path=:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path].cjs?path=:path*"
    }
  ]
}
