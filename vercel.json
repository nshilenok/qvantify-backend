{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [{ "src": "static/**", "use": "@vercel/static" }],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://qvantify.up.railway.app/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://qvantify.up.railway.app/api/:path*"
    },
    { "source": "/favicon.ico", "destination": "/static/favicon.ico" },
    { "source": "/favicon-16.png", "destination": "/static/favicon-16.png" },
    { "source": "/favicon-32.png", "destination": "/static/favicon-32.png" },
    { "source": "/asset-manifest.json", "destination": "/static/asset-manifest.json" },
    { "source": "/static/:path*", "destination": "/static/static/:path*" },
    { "source": "/results/assets/:path*", "destination": "/static/results/assets/:path*" },
    { "source": "/results/:path*", "destination": "/static/results/index.html" },
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/:path*", "destination": "/static/index.html" }
  ]
}

